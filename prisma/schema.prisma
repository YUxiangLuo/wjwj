// ============================================================
// 抽样统计虚拟仿真教学系统 - Prisma Schema V3.0
// ============================================================
// 数据库：MySQL 8.0+
// 共 22 张表
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 一、用户域（4表）
// ============================================================

/// 管理员表 - 系统预置唯一管理员账号
model Admin {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username       String    @unique @db.VarChar(50)
  password       String    @db.VarChar(255)
  isFirstLogin   Boolean   @default(true) @map("is_first_login")
  // V3.0 登录锁定
  loginFailCount Int       @default(0) @map("login_fail_count") @db.UnsignedTinyInt
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  studentTransfers StudentTransfer[]

  @@map("admin")
}

/// 教师表
model Teacher {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId     String    @unique @map("employee_id") @db.VarChar(50)
  name           String    @db.VarChar(100)
  password       String    @db.VarChar(255)
  isFirstLogin   Boolean   @default(true) @map("is_first_login")
  status         Int       @default(1) @db.TinyInt
  // V3.0 登录锁定
  loginFailCount Int       @default(0) @map("login_fail_count") @db.UnsignedTinyInt
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  assistants Assistant[]
  classes    Class[]
  topics     Topic[]

  @@index([status])
  @@map("teacher")
}

/// 助教表
model Assistant {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  account          String    @unique @db.VarChar(50)
  name             String    @db.VarChar(100)
  password         String    @db.VarChar(255)
  creatorTeacherId BigInt    @map("creator_teacher_id") @db.UnsignedBigInt
  isFirstLogin     Boolean   @default(true) @map("is_first_login")
  status           Int       @default(1) @db.TinyInt
  // V3.0 登录锁定
  loginFailCount   Int       @default(0) @map("login_fail_count") @db.UnsignedTinyInt
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  creatorTeacher   Teacher          @relation(fields: [creatorTeacherId], references: [id])
  assistantClasses AssistantClass[]

  @@index([creatorTeacherId])
  @@index([status])
  @@map("assistant")
}

/// 学生表
model Student {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  studentId      String    @unique @map("student_id") @db.VarChar(50)
  name           String    @db.VarChar(100)
  password       String    @db.VarChar(255)
  classId        BigInt    @map("class_id") @db.UnsignedBigInt
  isFirstLogin   Boolean   @default(true) @map("is_first_login")
  status         Int       @default(1) @db.TinyInt
  // V3.0 登录锁定
  loginFailCount Int       @default(0) @map("login_fail_count") @db.UnsignedTinyInt
  lockedUntil    DateTime? @map("locked_until")
  // V3.0 软删除
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  class     Class             @relation(fields: [classId], references: [id])
  experiments Experiment[]
  transfers   StudentTransfer[]

  @@index([classId])
  @@index([status])
  @@index([deletedAt])
  @@map("student")
}

// ============================================================
// 二、组织域（4表）
// ============================================================

/// 学期表
model Semester {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(20) // 格式：YYYY-Spring 或 YYYY-Fall
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  classes Class[]

  @@map("semester")
}

/// 班级表
model Class {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name       String   @db.VarChar(100)
  semesterId BigInt   @map("semester_id") @db.UnsignedBigInt
  teacherId  BigInt   @map("teacher_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  semester         Semester         @relation(fields: [semesterId], references: [id])
  teacher          Teacher          @relation(fields: [teacherId], references: [id])
  students         Student[]
  assistantClasses AssistantClass[]
  tasks            Task[]
  transfersFrom    StudentTransfer[] @relation("ClassTransferFrom")
  transfersTo      StudentTransfer[] @relation("ClassTransferTo")

  @@index([semesterId])
  @@index([teacherId])
  @@map("class")
}

/// 助教-班级绑定表
model AssistantClass {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  assistantId BigInt   @map("assistant_id") @db.UnsignedBigInt
  classId     BigInt   @map("class_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([assistantId, classId])
  @@index([classId])
  @@map("assistant_class")
}

/// 【V3.0】学生转班记录表
model StudentTransfer {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  studentId     BigInt   @map("student_id") @db.UnsignedBigInt
  fromClassId   BigInt   @map("from_class_id") @db.UnsignedBigInt
  toClassId     BigInt   @map("to_class_id") @db.UnsignedBigInt
  reason        String?  @db.VarChar(500)
  operatedBy    BigInt   @map("operated_by") @db.UnsignedBigInt
  transferredAt DateTime @default(now()) @map("transferred_at")

  // Relations
  student   Student @relation(fields: [studentId], references: [id])
  fromClass Class   @relation("ClassTransferFrom", fields: [fromClassId], references: [id])
  toClass   Class   @relation("ClassTransferTo", fields: [toClassId], references: [id])
  operator  Admin   @relation(fields: [operatedBy], references: [id])

  @@index([studentId])
  @@index([fromClassId])
  @@index([toClassId])
  @@map("student_transfer")
}

// ============================================================
// 三、教学域（4表）
// ============================================================

/// 课题表
model Topic {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  teacherId     BigInt    @map("teacher_id") @db.UnsignedBigInt
  name          String    @db.VarChar(200)
  description   String?   @db.Text
  // 数据文件相关
  excelFilePath String?   @map("excel_file_path") @db.VarChar(500)
  excelRowCount Int       @default(0) @map("excel_row_count") @db.UnsignedInt
  // JSON 配置
  fieldMapping  Json?     @map("field_mapping")
  weightConfig  Json?     @map("weight_config")
  status        Int       @default(0) @db.TinyInt // 0-草稿，1-已发布
  isDeleted     Boolean   @default(false) @map("is_deleted")
  // V3.0 编辑锁定
  lockedBy      BigInt?   @map("locked_by") @db.UnsignedBigInt
  lockedAt      DateTime? @map("locked_at")
  // V3.0 软删除时间
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  teacher             Teacher                  @relation(fields: [teacherId], references: [id])
  attachments         TopicAttachment[]
  recommendQuestions  TopicRecommendQuestion[]
  tasks               Task[]

  @@index([teacherId])
  @@index([status])
  @@index([deletedAt])
  @@map("topic")
}

/// 课题附件表
model TopicAttachment {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  topicId   BigInt   @map("topic_id") @db.UnsignedBigInt
  fileName  String   @map("file_name") @db.VarChar(255)
  filePath  String   @map("file_path") @db.VarChar(500)
  fileType  String   @map("file_type") @db.VarChar(50) // image/video/document
  fileSize  BigInt   @default(0) @map("file_size") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_attachment")
}

/// 课题推荐题目表
model TopicRecommendQuestion {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  topicId      BigInt   @map("topic_id") @db.UnsignedBigInt
  questionType Int      @map("question_type") @db.TinyInt // 1-判断题，2-单选题，3-多选题，4-满意度量表
  content      String   @db.VarChar(500)
  options      Json?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_recommend_question")
}

/// 任务表
model Task {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  topicId   BigInt    @map("topic_id") @db.UnsignedBigInt
  classId   BigInt    @map("class_id") @db.UnsignedBigInt
  openTime  DateTime? @map("open_time")
  deadline  DateTime?
  // V3.0 软删除
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  topic       Topic        @relation(fields: [topicId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  experiments Experiment[]

  @@unique([topicId, classId])
  @@index([classId])
  @@index([deletedAt])
  @@map("task")
}

// ============================================================
// 四、实验域（2表）
// ============================================================

/// 学生实验记录表
model Experiment {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  studentId         BigInt    @map("student_id") @db.UnsignedBigInt
  taskId            BigInt    @map("task_id") @db.UnsignedBigInt
  // 当前进度
  currentStage      Int       @default(0) @map("current_stage") @db.TinyInt // 0-未开始，1-问卷设计，2-样本量规划，3-抽样执行，4-分析报告
  status            Int       @default(0) @db.TinyInt // 0-进行中，1-已提交，2-已批改，3-被驳回
  // 阶段数据 (JSON)
  questionnaire     Json?
  samplePlan        Json?     @map("sample_plan")
  samplingResults   Json?     @map("sampling_results")
  samplingDataPath  String?   @map("sampling_data_path") @db.VarChar(500)
  reportContent     String?   @map("report_content") @db.Text
  // 时间记录
  stage1CompletedAt DateTime? @map("stage1_completed_at")
  stage2CompletedAt DateTime? @map("stage2_completed_at")
  stage3CompletedAt DateTime? @map("stage3_completed_at")
  stage4CompletedAt DateTime? @map("stage4_completed_at")
  // V3.0 自动保存和版本控制
  lastSavedAt       DateTime? @map("last_saved_at")
  version           Int       @default(1) @db.UnsignedInt
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  student     Student      @relation(fields: [studentId], references: [id])
  task        Task         @relation(fields: [taskId], references: [id])
  submissions Submission[]

  @@unique([studentId, taskId])
  @@index([taskId])
  @@index([status])
  @@map("experiment")
}

/// 提交记录表
model Submission {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  experimentId         BigInt    @map("experiment_id") @db.UnsignedBigInt
  // 提交内容快照
  questionnairePdfPath String?   @map("questionnaire_pdf_path") @db.VarChar(500)
  reportPdfPath        String?   @map("report_pdf_path") @db.VarChar(500)
  // 评分
  scoreQuestionnaire   Decimal?  @map("score_questionnaire") @db.Decimal(5, 2)
  scoreProcess         Decimal?  @map("score_process") @db.Decimal(5, 2)
  scoreReport          Decimal?  @map("score_report") @db.Decimal(5, 2)
  totalScore           Decimal?  @map("total_score") @db.Decimal(5, 2)
  // 评语
  teacherComment       String?   @map("teacher_comment") @db.Text
  rejectReason         String?   @map("reject_reason") @db.Text
  // 状态：0-批改草稿，1-待批改，2-已批改（通过），3-被驳回
  status               Int       @default(1) @db.TinyInt
  // 批改人
  gradedByType         Int?      @map("graded_by_type") @db.TinyInt // 2-教师，3-助教
  gradedById           BigInt?   @map("graded_by_id") @db.UnsignedBigInt
  // V3.0 批改锁定
  lockedByType         Int?      @map("locked_by_type") @db.TinyInt
  lockedById           BigInt?   @map("locked_by_id") @db.UnsignedBigInt
  lockedAt             DateTime? @map("locked_at")
  submittedAt          DateTime  @default(now()) @map("submitted_at")
  gradedAt             DateTime? @map("graded_at")

  // Relations
  experiment Experiment @relation(fields: [experimentId], references: [id])

  @@index([experimentId])
  @@index([status])
  @@index([lockedAt])
  @@map("submission")
}

// ============================================================
// 五、系统域（8表）
// ============================================================

/// 公告表
model Announcement {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title     String   @db.VarChar(100)
  content   String   @db.Text
  status    Int      @default(1) @db.TinyInt // 1-已发布，0-已下架
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  reads AnnouncementRead[]

  @@index([status])
  @@map("announcement")
}

/// 公告已读表
model AnnouncementRead {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  announcementId BigInt   @map("announcement_id") @db.UnsignedBigInt
  userType       Int      @map("user_type") @db.TinyInt // 1-管理员，2-教师，3-助教，4-学生
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  readAt         DateTime @default(now()) @map("read_at")

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userType, userId])
  @@index([userType, userId])
  @@map("announcement_read")
}

/// 登录日志表
model LoginLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userType  Int      @map("user_type") @db.TinyInt // 1-管理员，2-教师，3-助教，4-学生
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  loginAt   DateTime @default(now()) @map("login_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45) // 支持 IPv6
  userAgent String?  @map("user_agent") @db.VarChar(500)

  @@index([userType, userId])
  @@index([loginAt])
  @@map("login_log")
}

/// 系统监控数据表
model SystemMetrics {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  metricType  String   @map("metric_type") @db.VarChar(50) // cpu, memory, disk, active_users, api_requests
  metricValue Decimal  @map("metric_value") @db.Decimal(10, 2)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([metricType, recordedAt])
  @@map("system_metrics")
}

/// 操作日志表
model OperationLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userType   Int      @map("user_type") @db.TinyInt // 1-管理员，2-教师，3-助教，4-学生
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   BigInt?  @map("target_id") @db.UnsignedBigInt
  detail     Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userType, userId])
  @@index([action])
  @@index([createdAt])
  @@map("operation_log")
}

/// 【V3.0】会话管理表
model UserSession {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sessionToken String   @unique @map("session_token") @db.VarChar(128)
  userType     Int      @map("user_type") @db.TinyInt // 1-管理员，2-教师，3-助教，4-学生
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  deviceInfo   String?  @map("device_info") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  @@index([userType, userId])
  @@index([expiresAt])
  @@map("user_session")
}

/// 【V3.0】通知表
model Notification {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  // 接收者
  receiverType Int       @map("receiver_type") @db.TinyInt // 1-管理员，2-教师，3-助教，4-学生
  receiverId   BigInt    @map("receiver_id") @db.UnsignedBigInt
  // 通知内容
  type         String    @db.VarChar(50) // TASK_PUBLISHED, SUBMISSION_GRADED, SUBMISSION_REJECTED 等
  title        String    @db.VarChar(200)
  content      String    @db.Text
  // 关联信息
  relatedType  String?   @map("related_type") @db.VarChar(50)
  relatedId    BigInt?   @map("related_id") @db.UnsignedBigInt
  // 状态
  isRead       Boolean   @default(false) @map("is_read")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([receiverType, receiverId, isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notification")
}

/// 【V3.0】系统配置表
model SystemConfig {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.Text
  valueType   String   @default("string") @map("value_type") @db.VarChar(20) // string/int/boolean/json
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
