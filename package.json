{
  "name": "sampling-vlab",
  "version": "0.1.0",
  "description": "Sampling statistics virtual simulation teaching platform built with Bun",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "DISABLE_AUTO_BACKUP=1 DISABLE_NOTIFICATION_CLEANUP=1 DISABLE_DEADLINE_REMINDER=1 bun --hot src/index.ts",
    "dev:full": "RUN_IN_PROCESS_SCHEDULERS=1 bun --hot src/index.ts",
    "dev:worker": "bun --hot src/worker.ts",
    "start:e2e": "DISABLE_AUTO_BACKUP=1 DISABLE_NOTIFICATION_CLEANUP=1 DISABLE_DEADLINE_REMINDER=1 NODE_ENV=production bun src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "start:legacy": "RUN_IN_PROCESS_SCHEDULERS=1 NODE_ENV=production bun src/index.ts",
    "worker": "NODE_ENV=production bun src/worker.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:drop": "bunx drizzle-kit drop",
    "db:check": "bunx drizzle-kit check",
    "db:clean": "bun run src/db/clean.ts --force",
    "db:seed": "bun run src/db/seeds/default.ts",
    "db:reset": "bun run db:clean && bun run db:push && bun run db:seed",
    "theme:check": "bun run scripts/migrate-theme.ts --check",
    "e2e:admin": "bun run scripts/e2e/admin-smoke.ts",
    "e2e:admin:live": "E2E_USE_EXISTING_SERVER=1 E2E_SKIP_DB_RESET=1 E2E_SKIP_DB_RESEED=1 bun run scripts/e2e/admin-smoke.ts",
    "e2e:teacher": "bun run scripts/e2e/teacher-smoke.ts",
    "e2e:teacher:live": "E2E_USE_EXISTING_SERVER=1 E2E_SKIP_DB_RESET=1 E2E_SKIP_DB_RESEED=1 bun run scripts/e2e/teacher-smoke.ts",
    "e2e:teacher-student": "bun run scripts/e2e/teacher-student-linkage.ts",
    "e2e:teacher-student:live": "E2E_USE_EXISTING_SERVER=1 E2E_SKIP_DB_RESET=1 E2E_SKIP_DB_RESEED=1 bun run scripts/e2e/teacher-student-linkage.ts",
    "e2e:student": "bun run scripts/e2e/student-smoke.ts",
    "e2e:student:live": "E2E_USE_EXISTING_SERVER=1 E2E_SKIP_DB_RESET=1 E2E_SKIP_DB_RESEED=1 bun run scripts/e2e/student-smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.545.0",
    "mysql2": "^3.16.1",
    "pdfkit": "^0.17.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.12.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "happy-dom": "^20.8.3",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
