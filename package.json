{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test src env.test.ts",
    "test:watch": "bun test src env.test.ts --watch",
    "test:unit": "bun test src env.test.ts",
    "test:e2e:admin": "E2E_RESET_SCRIPT=db:reset:e2e:admin bunx playwright test tests/e2e/admin",
    "test:e2e:teacher": "E2E_RESET_SCRIPT=db:reset:e2e:teacher bunx playwright test tests/e2e/teacher",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:env": "bun test env.test.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:drop": "bunx drizzle-kit drop",
    "db:check": "bunx drizzle-kit check",
    "db:reset": "bun run src/db/clean.ts --force && bun run db:push && bun run src/db/seeds/default.ts",
    "db:reset:e2e:admin": "bun run src/db/clean.ts --force && bun run db:push && bun run src/db/seeds/admin-e2e.ts",
    "db:reset:e2e:teacher": "bun run src/db/clean.ts --force && bun run db:push && bun run src/db/seeds/teacher-e2e.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.545.0",
    "mysql2": "^3.16.1",
    "pdfkit": "^0.17.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.12.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
